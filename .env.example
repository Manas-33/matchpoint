# Copy to .env (git-ignored) and fill in. Sandbox / test keys only.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding the webhook to the sandbox app
PAYPAL_WEBHOOK_ID=

# Channel3 (trychannel3.com/dashboard)
CHANNEL3_API_KEY=
# Signing secret for the Channel3 webhook endpoint, if the dashboard shows one
CHANNEL3_WEBHOOK_SECRET=

# Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local webhook receiver port (tunnel points here)
WEBHOOK_PORT=8787
