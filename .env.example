# Copy to .env (git-ignored) and fill in. Sandbox / test keys only.
# Validated at startup by lib/env.ts. Empty values count as unset.

# true: Channel3, PayPal and Claude calls are answered from recorded fixtures/ and email is only
# logged, so no API keys are needed. false (default): live mode, which needs the keys marked "live".
DEMO_MODE=false

# Postgres. The default matches docker-compose.yml (npm run db:up).
DATABASE_URL=postgres://matchpoint:matchpoint@localhost:5433/matchpoint

# Public base URL of the app (PayPal return/cancel URLs, links in emails)
APP_URL=http://localhost:3000

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox). Live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding the webhook to the sandbox app
PAYPAL_WEBHOOK_ID=

# Channel3 (trychannel3.com/dashboard). Live.
CHANNEL3_API_KEY=
# Signing secret (whsec_...) for the Channel3 webhook endpoint
CHANNEL3_WEBHOOK_SECRET=

# Anthropic (console.anthropic.com > API keys). Live.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (resend.com). Optional: without a key, email is logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Matchpoint Demo Shop <onboarding@resend.dev>

# Phase 0 spike webhook receiver port (npm run spike:webhooks; tunnel points here)
WEBHOOK_PORT=8787
